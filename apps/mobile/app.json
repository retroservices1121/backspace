{
  "expo": {
    "name": "Backspace",
    "slug": "mobile-iframe-expo",
    "owner": "newsocial",
    "version": "1.3.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "notification": {
      "icon": "./assets/icon.png"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#5822FB"
    },
    "updates": {
