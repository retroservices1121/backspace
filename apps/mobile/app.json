    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#5822FB"
      },
      "package": "com.newsocial.backspace",
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b02ed1ec-8c65-4c09-b2d4-20ff2ca988ec"
      }
    }
  }
