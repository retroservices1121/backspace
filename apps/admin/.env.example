# Admin uses its OWN Privy app, distinct from apps/web.
# Create a separate Privy app at https://dashboard.privy.io and put its
# credentials here. A token from the user-facing Privy app must NOT
# authenticate against admin.
NEXT_PUBLIC_ADMIN_PRIVY_APP_ID=
ADMIN_PRIVY_APP_ID=
ADMIN_PRIVY_APP_SECRET=

# Same Postgres as apps/web (they share schema via @backspace/db).
# Use a Postgres role with broader privileges than the web app's role
# if you want defense-in-depth.
DATABASE_URL=
