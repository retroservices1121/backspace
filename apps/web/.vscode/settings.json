{
  "autoSnippet.snippets": [
    {
      "regex": ".*\\.ts[x]",
      "snippet": "React File License"
    },
    {
      "regex": ".*\\.ts",
      "snippet": "File License"
    },
  ],
  "typescript.tsdk": "node_modules/typescript/lib",
  "cSpell.words": [
    "convo",
    "immer",
    "Normalizr",
    "Uncapitalize"
