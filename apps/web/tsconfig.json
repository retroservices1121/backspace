{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": "./src",
    "downlevelIteration": true,
    "paths": {
      "root/*": ["../*"],
      "public/*": ["../public/*"],
      "@src/*": ["*"]
    }
  },
  "include": [
    "src",
    "next-env.d.ts",
    "custom.d.ts", 
    "next.d.ts"],
  "exclude": [
    "node_modules",
    "tailwind.config.js"
  ]
}
