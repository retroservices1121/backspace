{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packageManager": "pnpm",
  "packages": {
    "node": "20"
  },
  "steps": {
    "install": {
      "commands": ["pnpm install --frozen-lockfile"]
    },
    "build": {
      "commands": [
        "pnpm --filter @backspace/db generate",
        "pnpm --filter $APP_FILTER build"
      ]
    }
  },
  "deploy": {
    "startCommand": "pnpm --filter $APP_FILTER start"
  }
}
